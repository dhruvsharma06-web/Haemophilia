rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /assessment_errors/{patientId}/{sessionId}/{fileName} {
      function signedIn() {
        return request.auth != null;
      }

      function myUser() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      }

      function isAdmin() {
        return signedIn() && myUser().data.role == 'admin';
      }

      function isAssignedDoctor() {
        return signedIn()
          && myUser().data.role == 'doctor'
          && firestore.get(/databases/(default)/documents/users/$(patientId)).data.doctorId == request.auth.uid;
      }

      // Patients upload their own error evidence. Assigned doctors and admins
      // can review it. Images are JPEGs produced by the assessment backend.
      allow write: if signedIn() && request.auth.uid == patientId
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;

      allow read: if signedIn()
        && (request.auth.uid == patientId || isAssignedDoctor() || isAdmin());
    }
  }
}
